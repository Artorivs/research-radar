# Which model reads and scores Entries: claude (default) or ollama (free, runs on this Mac; see README)
RADAR_PROVIDER=claude

# For claude: your Anthropic API key, from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional model override.
#   claude default: claude-haiku-5-5 (claude-opus-5-5 judges better at about 40x the cost)
#   ollama default: qwen3:14b (qwen3:30b is better with 32 GB of memory or more)
# RADAR_MODEL=

# For ollama, if it isn't on the usual address:
# OLLAMA_HOST=http://localhost:11434

# Optional but recommended: a free OpenAlex API key, from your account at https://openalex.org.
# Without one, OpenAlex's daily allowance covers only a run or two (see README, "OpenAlex key").
# OPENALEX_API_KEY=
