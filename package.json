{
  "name": "research-radar",
  "version": "0.1.0",
  "description": "A personal radar for academic papers, events, calls and opportunities, ranked against a researcher's interests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "radar": "node --experimental-strip-types --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "fast-xml-parser": "^5.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
